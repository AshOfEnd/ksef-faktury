# -----------------------------------------------
# KSeF API 2.0 — Konfiguracja
# -----------------------------------------------
DB_CONNECTION_STRING="DB" #podać connection string (nazwa tabeli hardcode)

# NIP firmy (bez kresek, tylko cyfry) dodać tylu klientów ile potrzeba
KSEF_NIP_1=xxxxxx
KSEF_TOKEN_1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx



# Token KSeF wygenerowany w Module Certyfikatów i Uprawnień
# https://ksef.podatki.gov.pl → Moduł Certyfikatów i Uprawnień → Tokeny





# Środowisko: test | prod
# test = https://api-test.ksef.mf.gov.pl  (bezpieczne, środowisko testowe)
 prod = https://api.ksef.mf.gov.pl        (produkcja — aktywna od 02.2026)
KSEF_ENV=prod


#BIWEEKLY uruchomi skrypt w każdą przystą niedziele (co 2tyg) IF RANGE_EXPORT=True: BIWEEKLY_EXPORT=FALSE zawsze 
AUTO_YESTERDAY=true
BIWEEKLY_EXPORT=true
RANGE_EXPORT=false

# Zakres dat do pobrania faktur (format: YYYY-MM-DD) jesli RANGE_EXPORT=false
DATE_FROM=2026-02-01
DATE_TO=2026-02-07

# Liczba faktur na stronę (1–250)
PAGE_SIZE=250




